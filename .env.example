# 扶摇 Fuyao（同花顺）API key（行情/竞价/涨跌停池/估值/财务主源）
# GET https://fuyao.aicubes.cn，认证头 X-api-key；注意限流（429/4001），批量请求已内置串行+延迟
FUYAO_API_KEY=your_fuyao_api_key_here
# Tushare token（行业归属 stock_basic、资金流向 moneyflow 主源；快照/K线/估值降级源，需 5000 积分）
TUSHARE_TOKEN=your_tushare_token_here
# 访问口令：设置后全站（页面+API）需要登录，不设置则登录禁用、直接放行
# 建议强口令（16 位以上字母数字符号）；会话 Cookie 有效期 7 天
ADMIN_PASSWORD=change_me_to_a_strong_password
